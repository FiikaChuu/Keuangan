{
  "id": "/",
  "name": "SkyWallet \u2014 Your money, in balance.",
  "short_name": "SkyWallet",
  "description": "Ruang tenang untuk uang, rencana, dan masa depanmu.",
  "lang": "id",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F9F8F6",
  "theme_color": "#F9F8F6",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "receipt",
          "accept": ["image/jpeg", "image/png", "image/webp"]
        }
      ]
    }
  }
}
